<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/cl_primary"
    tools:context=".ui.fragment.HomeFragment">
    <LinearLayout
        android:id="@+id/v_search"
        android:gravity="center_vertical"
        android:layout_marginLeft="@dimen/_13sdp"
        android:layout_marginRight="@dimen/_13sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/ic_arrange"
        android:background="@drawable/cs_bg_view_search"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_width="0dp"
        android:layout_height="@dimen/_45sdp"
        android:orientation="horizontal">
        <ImageView
            android:layout_marginLeft="@dimen/_13sdp"
            android:layout_width="@dimen/_21sdp"
            android:layout_height="@dimen/_21sdp"
            android:src="@drawable/ic_nav_search"/>
        <com.example.test.ui.csview.CsTextContent
            android:layout_marginLeft="@dimen/_11sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_your_dream_car"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ic_arrange"
        app:layout_constraintTop_toTopOf="@id/v_search"
        app:layout_constraintBottom_toBottomOf="@id/v_search"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="@dimen/_13sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrange"/>


</androidx.constraintlayout.widget.ConstraintLayout>