<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cl_primary"
    tools:context=".ui.activity.LoginActivity">


    <com.example.test.ui.csview.CsButton
        android:id="@+id/cs_btn"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:text="Login"
        app:typeColor="black"/>

    <com.example.test.ui.csview.CsEditText
        android:layout_marginLeft="@dimen/_13sdp"
        android:layout_marginRight="@dimen/_13sdp"
        app:layout_constraintTop_toBottomOf="@id/cs_btn"
        android:hint="Hello"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"/>

<!--    <Button-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="@dimen/_100sdp"-->
<!--        android:background="@drawable/cs_btn_black"/>-->


</androidx.constraintlayout.widget.ConstraintLayout>