<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/cl_primary"
    tools:context=".ui.fragment.SearchFragment">

    <EditText
        android:id="@+id/edt_search"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_width="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/ic_arrange"
        android:layout_marginLeft="@dimen/_13sdp"
        android:layout_marginRight="@dimen/_13sdp"
        android:layout_height="@dimen/_45sdp"
        android:textSize="@dimen/_11sdp"
        android:drawablePadding="@dimen/_10sdp"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:hint="@string/search_your_dream_car"
        android:textColor="#000000"
        android:fontFamily="@font/roboto_regular"
        android:drawableLeft="@drawable/ic_nav_search"
        android:background="@drawable/cs_bg_view_search"/>

    <ImageView
        android:id="@+id/ic_arrange"
        app:layout_constraintTop_toTopOf="@id/edt_search"
        app:layout_constraintBottom_toBottomOf="@id/edt_search"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="@dimen/_13sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrange"/>


</androidx.constraintlayout.widget.ConstraintLayout>